{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "vue-keyboard",
    "main": "./src/index.ts",
    "compatibility_date": "2026-01-01",
    "compatibility_flags": [],
    "observability": {
        "enabled": true
    },
    "assets": {
        "directory": "./src/.vitepress/dist/",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
    } 
}